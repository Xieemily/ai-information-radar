# Runtime
DATABASE_URL=sqlite:///./data/radar.db
APP_TIMEZONE=Asia/Shanghai
OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian Vault
LEGACY_FEEDS_FILE=/Users/you/Documents/Obsidian Vault/Scripts/newsletter/feeds.txt
ALLOW_PRIVATE_SOURCES=false
# Enable only when a local TUN proxy resolves public domains to 198.18.0.0/15.
ALLOW_PROXY_FAKE_IPS=false

# Optional OpenAI-compatible endpoint. Leave blank for deterministic local briefs.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Source limits
FETCH_TIMEOUT_SECONDS=15
MAX_ITEMS_PER_SOURCE=50
MAX_FEED_BYTES=5242880
MAX_ITEM_CONTENT_CHARS=50000
